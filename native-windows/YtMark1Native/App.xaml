<Application x:Class="YtMark1Native.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="BrandTeal">#0F766E</Color>
    <Color x:Key="BrandBlue">#1D4ED8</Color>
    <Color x:Key="BrandAmber">#F59E0B</Color>
    <SolidColorBrush x:Key="BrandInkBrush" Color="#152238" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FCFEFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D9E1EA" />
  </Application.Resources>
</Application>
