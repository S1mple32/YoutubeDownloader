<Window x:Class="YtMark1Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:YtMark1Native.Controls"
        mc:Ignorable="d"
        Title="YtMark1 Native"
        Width="1280"
        Height="860"
        MinWidth="1080"
        MinHeight="760"
        Background="#F4F6F8">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#FCFEFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="12" Padding="20">
        <DockPanel LastChildFill="True">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <controls:LogoMark Margin="0,0,14,0" />
            <StackPanel>
              <TextBlock Text="Native Windows preview" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
              <TextBlock Text="YtMark1" FontSize="34" FontWeight="Heavy" Foreground="#152238" />
            </StackPanel>
          </StackPanel>

          <StackPanel HorizontalAlignment="Right">
            <TextBlock Text="Bundled downloader" FontSize="12" FontWeight="Bold" Foreground="#647187" TextAlignment="Right" />
            <TextBlock Text="yt-dlp + ffmpeg will live inside the installed app" FontSize="13" FontWeight="SemiBold" Foreground="#152238" TextAlignment="Right" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Margin="0,18,0,0" Background="#FFF9ED" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="10" Padding="16">
        <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#5C420F"
                   Text="This native Windows rewrite is being shaped so the installed app carries its own downloader resources, instead of asking the user to install Node.js or yt-dlp separately." />
      </Border>

      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,9,0" Background="#FCFEFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel>
            <TextBlock Text="Download" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
            <TextBlock Text="Add a video link" FontSize="21" FontWeight="Heavy" Margin="0,4,0,16" />

            <TextBlock Text="Video URL" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBox Margin="0,8,0,14" Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Quality" FontSize="12" FontWeight="Bold" Foreground="#647187" />
                <ComboBox Margin="0,8,0,0" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Format" FontSize="12" FontWeight="Bold" Foreground="#647187" />
                <ComboBox Margin="0,8,0,0" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}" />
              </StackPanel>
            </Grid>

            <CheckBox Content="I have rights or permission to download this media."
                      Margin="0,0,0,14"
                      IsChecked="{Binding PermissionConfirmed}" />

            <Button Content="Add to queue" Width="140" Height="40" Click="QueueDownload_Click" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="9,0,0,0" Background="#FCFEFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel>
            <TextBlock Text="Settings" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
            <TextBlock Text="Bundled app controls" FontSize="21" FontWeight="Heavy" Margin="0,4,0,16" />

            <TextBlock Text="Current version" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBlock Text="{Binding CurrentVersion}" Margin="0,4,0,12" />

            <TextBlock Text="Latest release" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBlock Text="{Binding LatestVersion}" Margin="0,4,0,12" />

            <TextBlock Text="Update status" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,4,0,12" />

            <WrapPanel Margin="0,0,0,14">
              <Button Content="Check for updates" Margin="0,0,8,8" Click="CheckUpdates_Click" />
              <Button Content="Clear queue" Margin="0,0,8,8" Click="ClearQueue_Click" />
              <Button Content="Clear history" Margin="0,0,0,8" Click="ClearHistory_Click" />
            </WrapPanel>

            <TextBlock Text="Download folder" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBox Margin="0,8,0,14" Text="{Binding DownloadsFolder, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Cookies" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBlock Text="{Binding CookiesStatus}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Margin="0,18,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,9,0" Background="#FCFEFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel>
            <TextBlock Text="Queue" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
            <TextBlock Text="Download jobs" FontSize="21" FontWeight="Heavy" Margin="0,4,0,16" />

            <ItemsControl ItemsSource="{Binding Jobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FBFCFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding Source}" FontWeight="Bold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#0F766E" DockPanel.Dock="Right" />
                      </DockPanel>
                      <TextBlock Text="{Binding Url}" Foreground="#647187" TextWrapping="Wrap" Margin="0,6,0,8" />
                      <ProgressBar Value="{Binding Progress}" Maximum="100" Height="10" />
                      <TextBlock Text="{Binding Message}" Margin="0,8,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="9,0,0,0" Background="#FCFEFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel>
            <TextBlock Text="Playlists" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
            <TextBlock Text="Sync a playlist" FontSize="21" FontWeight="Heavy" Margin="0,4,0,16" />

            <TextBlock Text="Playlist URL" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBox Margin="0,8,0,14" Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Name" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <TextBox Margin="0,8,0,14" Text="{Binding PlaylistName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Sync" FontSize="12" FontWeight="Bold" Foreground="#647187" />
            <ComboBox Margin="0,8,0,14" ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SelectedSchedule}" />

            <Button Content="Sync playlist" Width="130" Height="40" Margin="0,0,0,14" Click="SyncPlaylist_Click" />

            <ItemsControl ItemsSource="{Binding Playlists}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FBFCFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                      <TextBlock Text="{Binding Url}" Foreground="#647187" TextWrapping="Wrap" Margin="0,6,0,6" />
                      <TextBlock Text="{Binding Schedule}" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0" Background="#FCFEFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel>
            <TextBlock Text="History" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
            <TextBlock Text="Downloaded files" FontSize="21" FontWeight="Heavy" Margin="0,4,0,16" />

            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FBFCFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Output}" Foreground="#647187" Margin="0,6,0,0" />
                      </StackPanel>
                      <TextBlock Text="{Binding CompletedAt}" FontWeight="SemiBold" Foreground="#0F766E" HorizontalAlignment="Right" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>
